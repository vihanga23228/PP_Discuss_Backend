# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and fill in.
#
# `.env` is read automatically on startup (spring-dotenv) and feeds the ${VAR}
# placeholders in src/main/resources/application.properties. It is gitignored —
# `.env.example` is the version that gets committed.
#
# A real environment variable always wins over the same key in this file, so
# production can keep using proper secrets management.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=1234

# --- Security --------------------------------------------------------------
# Base64, at least 32 bytes decoded. Generate a fresh one before deploying:
#   openssl rand -base64 48
# Keep this COMMENTED OUT rather than blank — an empty value overrides the
# built-in development secret with "" and breaks token signing.
# JWT_SECRET=

# Browsers allowed to call this API, comma separated
CORS_ORIGINS=http://localhost:3000

# --- Seeded administrator (only used the first time the app starts) --------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pharmacyexam.lk
ADMIN_PASSWORD=admin123

# --- Google Sign-In --------------------------------------------------------
# OAuth 2.0 "Web application" client id from
# https://console.cloud.google.com/apis/credentials
# The same value must also go in epe_pp_disc/.env.local as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# --- PDF paper import (vision extraction) ----------------------------------
# Works with either provider — the one to use is detected from the key:
#   Google Gemini  (free tier available)  https://aistudio.google.com/apikey
#   Anthropic      (key starts sk-ant-)   https://console.anthropic.com/settings/keys
# Leave blank and the importer still runs in "sample data" mode.
VISION_API_KEY=

# Gap between vision calls in milliseconds. 7000 = ~8 requests/minute, under the usual
# 10 RPM free-tier cap. Raise it if you still see rate limiting.
VISION_MIN_INTERVAL_MS=7000

# Where page renders and cropped figures are written
MEDIA_DIR=./media
